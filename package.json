{
  "name": "pi-grapevine",
  "version": "0.0.0",
  "private": true,
  "description": "Paranoid local messaging for Pi agents",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent-coordination",
    "local-ipc"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .tmp/test-build && tsc --noEmit false --outDir .tmp/test-build && node --test .tmp/test-build/tests/*.test.js"
  }
}
